{
  "name": "openrole-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "db:migrate": "prisma migrate deploy",
    "sources:import": "node dist/src/cli.js sources",
    "sync": "node dist/src/cli.js sync",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/integration/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "dotenv": "^17.2.0",
    "entities": "^7.0.0",
    "fast-xml-parser": "5.11.2",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.11.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
