generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  GREENHOUSE
  LEVER
  ASHBY
  SMARTRECRUITERS
  PERSONIO
  RECRUITEE
  MANUAL
}

enum JobStatus {
  ACTIVE
  CLOSED
  HIDDEN
}

enum RemoteType {
  REMOTE
  HYBRID
  ON_SITE
  UNKNOWN
}

model Company {
  id String @id @default(cuid())
  name String
  enabled Boolean @default(true)
  slug String @unique
  logoUrl String?
  website String?
  careerUrl String?
  country String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources Source[]
  jobs Job[]
}

model Source {
  id String @id @default(cuid())
  name String
  type SourceType
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceIdentifier String
  enabled Boolean @default(false)
  lastSyncAt DateTime?
  lastSuccessfulSync DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs Job[]
  importLogs ImportLog[]
  deletions DeletedJob[]
  @@unique([type, sourceIdentifier])
}

model Job {
  id String @id @default(cuid())
  externalId String
  slug String @unique
  title String
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceId String
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  description String
  shortDescription String
  category String
  location String
  city String?
  country String?
  region String?
  remoteType RemoteType @default(UNKNOWN)
  employmentType String?
  experienceLevel String?
  salaryMin Float?
  salaryMax Float?
  currency String?
  technologies String[] @default([])
  sourceUrl String
  applyUrl String
  publishedAt DateTime?
  firstSeenAt DateTime @default(now())
  lastCheckedAt DateTime
  sortDate DateTime
  missingSince DateTime?
  status JobStatus @default(ACTIVE)
  manualOverride Boolean @default(false)
  statusOverride Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sourceId, externalId])
  @@index([status, sortDate, id])
  @@index([publishedAt])
  @@index([category])
  @@index([country])
  @@index([region])
  @@index([remoteType])
  @@index([companyId])
  @@index([currency, salaryMin])
  @@index([technologies], type: Gin)
}

model AdminSession {
  tokenHash String @id
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model ImportLog {
  id String @id @default(cuid())
  sourceId String
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  status String @default("RUNNING")
  jobsFound Int @default(0)
  jobsCreated Int @default(0)
  jobsUpdated Int @default(0)
  jobsClosed Int @default(0)
  error String?
  @@index([startedAt])
  @@index([sourceId, startedAt])
}

model DeletedJob {
  sourceId String
  externalId String
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@id([sourceId, externalId])
}

model AnalyticsEvent {
  id String @id
  type String
  occurredAt DateTime @default(now())
  visitorId String
  sessionId String
  path String
  jobId String?
  referrer String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  trafficSource String
  country String?
  region String?
  city String?
  device String
  browser String
  os String
  @@index([occurredAt])
  @@index([jobId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId, occurredAt])
}
