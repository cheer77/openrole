# Owner secrets are generated by npm run admin:setup in the repository root.
# Docker loads .env.owner; for native API startup inject these securely:
# OWNER_PASSWORD_HASH=<scrypt salt:hash>
# INTERNAL_API_KEY=<same random key as Next.js>
