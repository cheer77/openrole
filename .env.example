# Server-side only; browsers (including mobile) contact Next.js, not this address.
API_URL=http://127.0.0.1:4000
# Generate INTERNAL_API_KEY with npm run admin:setup (server-side only).
# Production canonical browser origin; required behind a reverse proxy.
# APP_ORIGIN=https://jobs.example.com
# Keep secure cookies in production; false is only for local HTTP.
# ADMIN_COOKIE_SECURE=false
GEO_PROVIDER=none
